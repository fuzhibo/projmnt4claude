{
  "name": "projmnt4claude",
  "version": "1.36.0",
  "description": "Claude Code 项目管理 CLI 工具",
  "module": "src/index.ts",
  "main": "dist/projmnt4claude.js",
  "types": "src/index.ts",
  "type": "module",
  "bin": {
    "projmnt4claude": "./dist/projmnt4claude.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bash scripts/check-ai-invocation.sh && bun build src/index.ts --outfile dist/projmnt4claude.js --target node",
    "build:plugin": "bun run build && cp -r dist skills commands .claude-plugin ./plugin-dist/",
    "check:ai": "bash scripts/check-ai-invocation.sh",
    "check:ai:strict": "bash scripts/check-ai-invocation.sh --strict",
    "prepublishOnly": "bash scripts/run-tests-batched.sh && bun run build",
    "pre-commit": "bash scripts/check-ai-invocation.sh && bun run build && node dist/projmnt4claude.js --help",
    "pre-commit:full": "bash scripts/run-tests-batched.sh && bash scripts/check-ai-invocation.sh && bun run build && node dist/projmnt4claude.js --help",
    "test": "bash scripts/run-tests-batched.sh",
    "test:coverage": "bash scripts/run-tests-batched.sh",
    "test:all": "bun run src/scripts/batched-test-runner.ts --ci --no-bail",
    "test:ci": "bun run src/scripts/batched-test-runner.ts --ci",
    "test:group": "bun run src/scripts/batched-test-runner.ts --group",
    "test:watch": "jest --watch",
    "test:direct": "jest",
    "version:patch": "bash scripts/version-bump.sh patch",
    "version:minor": "bash scripts/version-bump.sh minor",
    "version:major": "bash scripts/version-bump.sh major",
    "sync-testmarketplace": "bash scripts/sync-testmarketplace.sh",
    "sync-marketplace": "bash scripts/sync-testmarketplace.sh",
    "release:patch": "bun run version:patch && bun run sync-testmarketplace",
    "release:minor": "bun run version:minor && bun run sync-testmarketplace",
    "release:major": "bun run version:major && bun run sync-testmarketplace"
  },
  "files": [
    "dist/",
    "skills/",
    "commands/",
    ".claude-plugin/",
    "README.md"
  ],
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/prompts": "^2.4.9",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "prompts": "^2.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "claude-code",
    "project-management",
    "task-management",
    "cli",
    "subtask"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuzhibo/projmnt4claude.git"
  }
}
