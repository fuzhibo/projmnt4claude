#!/bin/sh
# projmnt4claude pre-commit hook (增强版 - 目录级忽略检测)
#
# 安全检查：
# 1. 检查被忽略的文件是否被强制添加（读取 .gitignore 和 .git/info/exclude）
# 2. 检查被忽略的目录是否被强制添加（目录级检测）
# 3. 检测敏感文件模式
# 4. 检测敏感内容模式
# 5. 执行轻量检查（AI 调用 + 构建 + 基本功能）

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 运行 pre-commit 检查..."

# ============================================
# 第一阶段：忽略文件检查
# ============================================
echo "📋 检查忽略文件违规..."

STAGED_FILES=$(git diff --cached --name-only)
ERRORS=""
WARNINGS=""

# 收集所有忽略模式（包括目录级和文件级）
# 从 .gitignore 中提取忽略模式
IGNORED_PATTERNS=""
if [ -f ".gitignore" ]; then
    while IFS= read -r line; do
        # 跳过注释和空行
        case "$line" in
            \#*|""|!*) continue ;;
        esac
        # 收集所有非注释的忽略模式
        IGNORED_PATTERNS="$IGNORED_PATTERNS $line"
    done < ".gitignore"
fi

# 从 .git/info/exclude 中提取忽略模式
if [ -f ".git/info/exclude" ]; then
    while IFS= read -r line; do
        case "$line" in
            \#*|""|!*) continue ;;
        esac
        IGNORED_PATTERNS="$IGNORED_PATTERNS $line"
    done < ".git/info/exclude"
fi

# 从全局忽略文件中提取忽略模式
GLOBAL_IGNORE=$(git config --get core.excludesfile 2>/dev/null || true)
if [ -n "$GLOBAL_IGNORE" ] && [ -f "$GLOBAL_IGNORE" ]; then
    while IFS= read -r line; do
        case "$line" in
            \#*|""|!*) continue ;;
        esac
        IGNORED_PATTERNS="$IGNORED_PATTERNS $line"
    done < "$GLOBAL_IGNORE"
fi

# 提取目录级忽略模式（以 / 结尾的）
IGNORED_DIRS=""
for pattern in $IGNORED_PATTERNS; do
    case "$pattern" in
        */)
            # 移除末尾的 /
            dir_pattern="${pattern%/}"
            # 移除可能的通配符前缀
            CLEAN_DIR=$(echo "$dir_pattern" | sed 's/^\*\///')
            IGNORED_DIRS="$IGNORED_DIRS $CLEAN_DIR"
            ;;
    esac
done

if [ -n "$STAGED_FILES" ]; then
    for FILE in $STAGED_FILES; do
        # 检查 1: 是否应该被忽略（自动读取 .gitignore 和 .git/info/exclude）
        if git check-ignore -q "$FILE" 2>/dev/null; then
            # 获取忽略来源
            IGNORE_SOURCE=$(git check-ignore -v "$FILE" 2>/dev/null | cut -d: -f1)
            ERRORS="$ERRORS\n  ${RED}❌${NC} $FILE\n     忽略来源: $IGNORE_SOURCE"
        fi

        # 检查 2: 目录级忽略检测
        # 检查文件是否位于被忽略的目录中
        for IGNORED_DIR in $IGNORED_DIRS; do
            # 检查文件路径是否包含被忽略的目录
            case "$FILE" in
                $IGNORED_DIR/*|$IGNORED_DIR)
                    ERRORS="$ERRORS\n  ${RED}❌${NC} $FILE\n     位于被忽略的目录中: $IGNORED_DIR/"
                    break
                    ;;
            esac
        done

        # 检查 3: 敏感文件模式（仅警告，不阻止）
        case "$FILE" in
            *.env|*.env.*|*.pem|*.key|*.p12|*.pfx|\
            credentials.json|secrets.json|.htpasswd|\
            id_rsa|id_ed25519|*.private)
                # 如果文件未被忽略，发出警告
                if ! git check-ignore -q "$FILE" 2>/dev/null; then
                    WARNINGS="$WARNINGS\n  ${YELLOW}⚠️${NC} $FILE (敏感文件模式，建议添加到 .gitignore)"
                fi
                ;;
        esac

        # 检查 4: 敏感内容检测（仅对新增文件）
        if [ -f "$FILE" ] && file "$FILE" 2>/dev/null | grep -q "text"; then
            if git diff --cached --name-status "$FILE" 2>/dev/null | grep -q "^A"; then
                # 检测敏感内容模式
                if grep -qiE "(password|api_key|secret|token|private_key)\s*[:=]" "$FILE" 2>/dev/null; then
                    WARNINGS="$WARNINGS\n  ${YELLOW}⚠️${NC} $FILE (可能包含敏感内容)"
                fi
                # 检测私钥（阻止提交）
                if grep -q "BEGIN.*PRIVATE KEY" "$FILE" 2>/dev/null; then
                    ERRORS="$ERRORS\n  ${RED}❌${NC} $FILE (包含私钥，禁止提交)"
                fi
            fi
        fi
    done

    # 报告错误
    if [ -n "$ERRORS" ]; then
        echo ""
        echo -e "${RED}❌ 检测到违规文件：${NC}"
        echo -e "$ERRORS"
        echo ""
        echo "💡 解决方案："
        echo "   1. 移除文件: git reset HEAD <file>"
        echo "   2. 或使用: git rm --cached <file> (如果已跟踪)"
        echo ""
        echo "⚠️  注意: 使用 'git add -f' 绕过 .gitignore 是不安全的"
        exit 1
    fi

    # 报告警告
    if [ -n "$WARNINGS" ]; then
        echo ""
        echo -e "${YELLOW}⚠️  警告：${NC}"
        echo -e "$WARNINGS"
        echo ""
    fi
fi

echo -e "${GREEN}✅${NC} 忽略文件检查通过"

# ============================================
# 第二阶段：轻量检查
# ============================================
echo "🔧 执行轻量检查..."

# 执行 package.json 中定义的 pre-commit 脚本
if command -v bun >/dev/null 2>&1; then
    bun run pre-commit
elif command -v npm >/dev/null 2>&1; then
    npm run pre-commit
else
    echo -e "${RED}❌ 错误: 未找到 bun 或 npm${NC}"
    exit 1
fi

echo -e "${GREEN}✅ pre-commit 检查通过${NC}"
